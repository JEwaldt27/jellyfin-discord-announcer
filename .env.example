# ---- Discord -----------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=paste-your-bot-token-here

# ---- Jellyfin ----------------------------------------------------------
# The address the BOT uses to reach Jellyfin (LAN address is fine).
JELLYFIN_URL=http://192.168.1.100:8096

# Dashboard -> Advanced -> API Keys -> "+"
JELLYFIN_API_KEY=paste-your-jellyfin-api-key-here

# Optional. If you can reach Jellyfin from outside the LAN (reverse proxy,
# Tailscale, etc.), put that address here and every post gets a clickable
# link straight to the item. Leave blank to omit the link entirely.
JELLYFIN_PUBLIC_URL=

# ---- Media paths (only used by /imdb) ----------------------------------
# How Jellyfin reports movie paths, and where those same files are mounted on
# the machine running the bot. These MUST point at the same files.
#
# Find the Jellyfin side: open any movie in Jellyfin, look at its file path.
#   /movies/Heat (1995).mkv   ->   MOVIES_JELLYFIN_PATH=/movies
#
# The local side is your mount. docker-compose mounts it into the container at
# the same path automatically, so you only set it here.
MOVIES_JELLYFIN_PATH=/movies
MOVIES_LOCAL_PATH=/mnt/movies

# ---- TMDb (jellyfin_imdb_rename.py only) -------------------------------
# Optional. Free key: https://www.themoviedb.org/settings/api ("API Key", v3
# auth). Only used to look up movies that have no IMDb ID anywhere. Add it
# with ./add_tmdb_key.sh, or paste it here.
TMDB_API_KEY=

# ---- Discord roles -----------------------------------------------------
# Role required for every command that changes something: /imdb, /rebaseline,
# /scanrate and /channels. /start, /status and /help stay open to any member.
# Must match the Discord role name exactly. Enforced by the bot, so it applies
# to server admins too.
ADMIN_ROLE=Media Admin

# ---- Behaviour ---------------------------------------------------------
# Max embeds posted in a single scan. Anything beyond this is recorded as
# seen and summarised in one "…and N more" post, so a bulk library import
# can't flood the channel.
MAX_POSTS_PER_SCAN=20

# INFO is the right level for normal use. DEBUG is chatty.
LOG_LEVEL=INFO

# ---- Host user (docker-compose) ----------------------------------------
# Should match `id -u` / `id -g` on the homelab box so ./data stays writable.
PUID=1000
PGID=1000
